<?xml version='1.0' encoding='utf-8'?>
<MediaCodecs>
    <Include href="media_codecs_spatial.xml" />
    <Include href="media_codecs_google_audio.xml" />
    <Settings>
        <Setting name="max-video-encoder-input-buffers" value="1" />
        <Setting name="supports-multiple-secure-codecs" value="false" />
        <Setting name="supports-secure-with-non-secure-codec" value="false" />
    </Settings>
    <Decoders>
        <MediaCodec name="OMX.MS.M4V.Decoder" type="video/mp4v-es">
            <Limit name="concurrent-instances" max="2" />
            <Limit name="size" min="32x32" max="1920x1080" />
        </MediaCodec>
        <MediaCodec name="OMX.MS.H263.Decoder" type="video/3gpp">
            <Limit name="concurrent-instances" max="2" />
        </MediaCodec>
        <MediaCodec name="OMX.MS.AVC.Decoder" type="video/avc">
            <Limit name="concurrent-instances" max="2" />
            <Limit name="size" min="64x64" max="1920x1088" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="2073600" />
            <Feature name="adaptive-playback" />
            <Feature name="tunneled-playback" />
        </MediaCodec>
        <MediaCodec name="OMX.MS.AVC.Decoder.secure" type="video/avc">
            <Limit name="concurrent-instances" max="1" />
            <Limit name="size" min="64x64" max="1920x1088" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="2073600" />
            <Feature name="adaptive-playback" />
            <Feature name="tunneled-playback" />
            <Feature name="secure-playback" required="true" />
        </MediaCodec>
        <MediaCodec name="OMX.MS.DIVX_AVC.Decoder" type="video/divx-avc">
            <Limit name="concurrent-instances" max="2" />
            <Limit name="size" min="64x64" max="1920x1088" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="2073600" />
            <Feature name="adaptive-playback" />
            <Feature name="tunneled-playback" />
        </MediaCodec>
        <MediaCodec name="OMX.MS.HEVC.Decoder" type="video/hevc">
            <Limit name="concurrent-instances" max="2" />
            <Limit name="size" min="64x64" max="4096x2176" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="2088960" />
            <Feature name="adaptive-playback" />
            <Feature name="tunneled-playback" />
        </MediaCodec>
        <MediaCodec name="OMX.MS.HEVC.Decoder.secure" type="video/hevc">
            <Limit name="concurrent-instances" max="1" />
            <Limit name="size" min="64x64" max="4096x2176" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="2088960" />
            <Feature name="adaptive-playback" />
            <Feature name="tunneled-playback" />
            <Feature name="secure-playback" required="true" />
        </MediaCodec>
        <MediaCodec name="OMX.MS.DIVX_HEVC.Decoder" type="video/divx-hevc">
            <Limit name="concurrent-instances" max="2" />
            <Limit name="size" min="64x64" max="4096x2176" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="2088960" />
            <Feature name="adaptive-playback" />
            <Feature name="tunneled-playback" />
        </MediaCodec>
        <MediaCodec name="OMX.MS.DOLBY_VISION.Decoder" type="video/dolby-vision">
            <Limit name="concurrent-instances" max="2" />
            <Limit name="size" min="64x64" max="4096x2176" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="2088960" />
            <Feature name="adaptive-playback" />
            <Feature name="tunneled-playback" />
        </MediaCodec>
        <MediaCodec name="OMX.MS.DOLBY_VISION.Decoder.secure" type="video/dolby-vision">
            <Limit name="concurrent-instances" max="1" />
            <Limit name="size" min="64x64" max="4096x2176" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="2088960" />
            <Feature name="adaptive-playback" />
            <Feature name="tunneled-playback" />
            <Feature name="secure-playback" required="true" />
        </MediaCodec>
        <MediaCodec name="OMX.MS.AVC.DOLBY_VISION.Decoder" type="video/dolby-vision">
            <Limit name="concurrent-instances" max="2" />
            <Limit name="size" min="64x64" max="1920x1080" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="2088960" />
            <Feature name="adaptive-playback" />
            <Feature name="tunneled-playback" />
        </MediaCodec>
        <MediaCodec name="OMX.MS.AVC.DOLBY_VISION.Decoder.secure" type="video/dolby-vision">
            <Limit name="concurrent-instances" max="1" />
            <Limit name="size" min="64x64" max="1920x1080" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="2088960" />
            <Feature name="adaptive-playback" />
            <Feature name="tunneled-playback" />
            <Feature name="secure-playback" required="true" />
        </MediaCodec>
        <MediaCodec name="OMX.MS.MPEG2.Decoder" type="video/mpeg2">
            <Limit name="concurrent-instances" max="2" />
        </MediaCodec>
        <MediaCodec name="OMX.MS.AVS2.Decoder" type="video/avs2">
            <Limit name="concurrent-instances" max="2" />
            <Limit name="size" min="64x64" max="4096x2160" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="2073600" />
