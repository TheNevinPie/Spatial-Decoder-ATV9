        </MediaCodec>
        <MediaCodec name="OMX.MS.DIVX311.Decoder" type="video/divx3">
            <Limit name="concurrent-instances" max="2" />
        </MediaCodec>
        <MediaCodec name="OMX.MS.DIVX412.Decoder" type="video/divx4">
            <Limit name="concurrent-instances" max="2" />
        </MediaCodec>
        <MediaCodec name="OMX.MS.DIVX5.Decoder" type="video/divx5">
            <Limit name="concurrent-instances" max="2" />
        </MediaCodec>
        <MediaCodec name="OMX.MS.FLV.Decoder" type="video/flv">
            <Limit name="concurrent-instances" max="2" />
        </MediaCodec>
        <MediaCodec name="OMX.MS.VC1.Decoder" type="video/VC1">
            <Limit name="concurrent-instances" max="2" />
        </MediaCodec>
        <MediaCodec name="OMX.MS.WMV3.Decoder" type="video/x-ms-wmv">
