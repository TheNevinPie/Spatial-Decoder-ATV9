            <Quirk name="requires-allocate-on-output-ports" />
        </MediaCodec>
        <MediaCodec name="OMX.MS.FLAC.Decoder" type="audio/flac">
            <Limit name="concurrent-instances" max="2" />
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
        </MediaCodec>
        <MediaCodec name="OMX.MS.Passthrough.Decoder" type="audio/passthrough">
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
        </MediaCodec>
        <!-- TEMP-PROD-SELECTION Begin: stock OMX.google decoders for the four
             spatial MIMEs are delisted so normal bytype selection resolves
             to OMX.test.spatial.*. Stock .so implementations remain on disk
             untouched; dtshd/dtse/dtslbr entries below stay listed.
        <MediaCodec name="OMX.google.ac3.decoder">
            <Type name="audio/ac3">
                <Limit name="channel-count" max="6" />
                <Limit name="sample-rate" ranges="32000,44100,48000" />
                <Limit name="bitrate" range="32000-640000" />
            </Type>
        </MediaCodec>
        <MediaCodec name="OMX.google.eac3.decoder">
            <Type name="audio/eac3">
                <Limit name="channel-count" max="8" />
                <Limit name="sample-rate" ranges="32000,44100,48000" />
                <Limit name="bitrate" range="32000-6144000" />
            </Type>
            <Type name="audio/eac3-joc">
                <Limit name="channel-count" max="16" />
                <Limit name="sample-rate" ranges="32000,44100,48000" />
                <Limit name="bitrate" range="32000-6144000" />
            </Type>
        </MediaCodec>
        <MediaCodec name="OMX.google.dts.decoder" type="audio/vnd.dts">
            <Limit name="channel-count" max="8" />
            <Limit name="sample-rate" ranges="8000,16000,32000,44100,48000,88200,96000,176400,192000" />
            <Limit name="bitrate" range="32000-24576000" />
        </MediaCodec>
        TEMP-PROD-SELECTION End -->
        <MediaCodec name="OMX.google.dtshd.decoder" type="audio/vnd.dts.hd">
            <Limit name="channel-count" max="8" />
            <Limit name="sample-rate" ranges="8000,16000,32000,44100,48000,88200,96000,176400,192000" />
            <Limit name="bitrate" range="32000-24576000" />
        </MediaCodec>
        <MediaCodec name="OMX.google.dtse.decoder" type="audio/vnd.dts.hd;profile=lbr">
            <Limit name="channel-count" max="8" />
            <Limit name="sample-rate" ranges="8000,16000,32000,44100,48000,88200,96000,176400,192000" />
            <Limit name="bitrate" range="32000-24576000" />
        </MediaCodec>
        <!-- TEMP-PROD-SELECTION: stock OMX.google.dtslbr.dec delisted. Its MIME
             audio/vnd.dts.lbr shares role audio_decoder.dts with audio/vnd.dts;
             the parser keeps only the first type per role, so this entry was
             never bytype-resolvable AND now blocks OMX.test.spatial.dts.
             dtshd/dtse above stay listed.
        <MediaCodec name="OMX.google.dtslbr.dec" type="audio/vnd.dts.lbr">
            <Limit name="channel-count" max="8" />
            <Limit name="sample-rate" ranges="8000,16000,32000,44100,48000,88200,96000,176400,192000" />
            <Limit name="bitrate" range="32000-24576000" />
        </MediaCodec>
        TEMP-PROD-SELECTION End -->
        <!-- TEMP-PROD-SELECTION: stock OMX.google.truehd.decoder delisted, see above.
        <MediaCodec name="OMX.google.truehd.decoder" type="audio/true-hd">
            <Limit name="channel-count" max="8" />
            <Limit name="sample-rate" ranges="44100,48000,96000,192000" />
            <Limit name="bitrate" range="32000-24576000" />
        </MediaCodec>
        TEMP-PROD-SELECTION End -->
    </Decoders>
    <Include href="media_codecs_google_video_le.xml" />
</MediaCodecs>